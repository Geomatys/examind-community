{
  "title": "test-secondary-service-evi",
  "type": "wcs",
  "process": {
    "id": "secondary-service-evi-process",
    "process_graph": {
      "load": {
        "process_id": "load_collection",
        "arguments": {
          "id": "martinique",
          "bands": ["0", "1", "2"]
        }
      },
      "bs3": {
        "process_id": "geotoolkit.coverage:bandselect",
        "arguments": {
          "coverage": {
            "from_node": "load"
          },
          "bands": [0]
        }
      },
      "bs4": {
        "process_id": "geotoolkit.coverage:bandselect",
        "arguments": {
          "coverage": {
            "from_node": "load"
          },
          "bands": [1]
        }
      },
      "bs8": {
        "process_id": "geotoolkit.coverage:bandselect",
        "arguments": {
          "coverage": {
            "from_node": "load"
          },
          "bands": [2]
        }
      },
      "sub": {
        "process_id": "geotoolkit.coverage:math:substract",
        "arguments": {
          "first": {
            "from_node": "bs8"
          },
          "second": {
            "from_node": "bs3"
          }
        }
      },
      "p1": {
        "process_id": "geotoolkit.coverage:math:multiplyWithValue",
        "arguments": {
          "value": 6.0,
          "coverage": {
            "from_node": "bs3"
          }
        }
      },
      "p2": {
        "process_id": "geotoolkit.coverage:math:multiplyWithValue",
        "arguments": {
          "value": 7.5,
          "coverage": {
            "from_node": "bs4"
          }
        }
      },
      "sumCoverages1": {
        "process_id": "geotoolkit.coverage:math:sum",
        "arguments": {
          "first": {
            "from_node": "bs8"
          },
          "second": {
            "from_node": "p1"
          }
        }
      },
      "sumCoverages2": {
        "process_id": "geotoolkit.coverage:math:sum",
        "arguments": {
          "first": {
            "from_node": "sumCoverages1"
          },
          "second": {
            "from_node": "p2"
          }
        }
      },
      "sum": {
        "process_id": "geotoolkit.coverage:math:sumWithValue",
        "arguments": {
          "coverage": {
            "from_node": "sumCoverages2"
          },
          "value": 1.0
        }
      },
      "div": {
        "process_id": "geotoolkit.coverage:math:divide",
        "arguments": {
          "first": {
            "from_node": "sub"
          },
          "second": {
            "from_node": "sum"
          }
        }
      },
      "p3": {
        "process_id": "geotoolkit.coverage:math:multiplyWithValue",
        "arguments": {
          "value": 2.5,
          "coverage": {
            "from_node": "div"
          }
        }
      },
      "save": {
        "process_id": "save_result",
        "arguments": {
          "format": "GTIFF",
          "data": {
            "from_node": "p3"
          }
        },
        "result": true
      }
    }
  }
}