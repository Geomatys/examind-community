            "parameters": [{
                    "name": "dataId",
                    "description": "Sentinel-2 data id",
                    "schema": [{
                            "type": "string"
                        }],
                    "optional": false
                }, {
                    "name": "bbox",
                    "description": "Spatial extent",
                    "schema": [{
                            "type": "object"
                        }],
                    "optional": false
                }, {
                    "name": "bands",
                    "description": "Bands to load",
